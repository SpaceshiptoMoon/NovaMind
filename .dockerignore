# ========================================
# NovaMind Docker 构建排除
# ========================================
# 根级 .dockerignore，作用于 docker/Dockerfile 的构建上下文

# 版本控制
.git/
.gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
backend/.venv/
backend/venv/
backend/.env
backend/.env.*

# 后端 YAML 配置（*.yaml 是 gitignored 的本地真实配置，含密码/密钥，
# 绝不能打进镜像；容器通过 compose 挂载 default.yaml 与 docker.yaml，
# 见 docker-compose.yml 的 app.volumes）
backend/src/setting/yaml_config/yaml/*.yaml
!backend/src/setting/yaml_config/yaml/*.example

# Node.js
frontend/node_modules/
# 前端本地 env 不得进构建上下文：vite 构建时会读取 frontend/.env 并把
# VITE_API_BASE_URL（本机开发直连 8100）烘焙进生产 bundle，部署后打不到 nginx 反代
frontend/.env
frontend/.env.*
!frontend/.env.example

# 文档（构建不需要）
*.md
!backend/README.md
docs/

# IDE
.idea/
.vscode/
.claude/

# Docker 文件本身
docker-compose*.yml
Dockerfile
.dockerignore

# 测试与临时文件
.pytest_cache/
.coverage
htmlcov/
*.log
*.tmp
backend/tests/

# 本地大目录：模型缓存在部署期由 deploy 脚本经容器下载到宿主机
# backend/.cache/deepdoc（compose 卷挂载），构建期不需要；.tmp 是上游
# 快照等临时材料。不排除会把几百 MB 上下文白白传给 Docker daemon。
backend/.cache/
.tmp/

# 数据目录
data/
logs/
uploads/
assets/

# 其他
*.egg-info/
dist/
build/
.eslintcache
