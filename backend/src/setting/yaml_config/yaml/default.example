project:
  name: novamind
  version: 0.1.0
  description: novamind backend

security:
  secret_key: "your-secret-key-here"
  algorithm: HS256
  access_token_expire_minutes: 30
  encryption_key: "your-aes256-encryption-key"

database:
  host: localhost
  port: 3306
  user: root
  password: "your-db-password"
  database: novamind_db
  pool_size: 10
  max_overflow: 20
  pool_timeout: 30
  pool_recycle: 3600
  pool_pre_ping: true

redis:
  enabled: false
  host: localhost
  port: 6379
  db: 0
  password: ""

minio:
  endpoint: "127.0.0.1:9005"
  access_key: "your-minio-access-key"
  secret_key: "your-minio-secret-key"
  secure: false
  region: us-east-1
  bucket_name: "novamind-dev"
  # 外部服务（DashScope 等）下载文件时的公网地址，如 https://minio.example.com
  # 本地开发留空即可，部署时必填
  public_endpoint:

elasticsearch:
  hosts:
    - "http://127.0.0.1:9200"
  username: "elastic"
  password: "your-es-password"
  index_prefix: kb
  default_embedding_dim: 1024
  analyzer: standard

vector_db:
  type: elasticsearch

admin:
  username: "admin"
  email: "admin@example.com"
  password: "your-admin-password"
  create_on_startup: true
  reset_password_if_exists: true

cors_origins: "*"

external_search:
  tavily:
    api_key: ""
    max_results: 10
    search_depth: basic
    timeout: 30
  serpapi:
    api_key: ""
    max_results: 10
    timeout: 30
  duckduckgo:
    max_results: 10
    timeout: 15

task_queue:
  max_jobs: 3
  job_timeout: 7200
  max_tries: 3
  retry_base_delay: 60
  queue_name: "arq:queue"

knowledge_base:
  parsing:
    # 视频 VLM 逐帧/逐组描述并发数（1=串行，默认 4，范围 1~20）。
    # 长视频 60 帧串行易逼近 arq job_timeout，有界并发降时延；
    # 过高可能触发 VLM 配额限流，配合 KB 级 vlm_fallback_model / vlm_skip_on_quota_error 降级。
    video_vlm_concurrency: 4
    # 本地 faster-whisper ASR 模型目录（绝对路径）；空则回退环境变量
    # NOVAMIND_LOCAL_WHISPER_MODEL_DIR，再空则用默认 ~/.cache/faster-whisper/tiny
    local_whisper_model_dir:
    # 本地 ASR 转写 CPU 线程数；空则按物理核自动取保守值（留至少 1 核给事件循环）。
    # 转写时其它请求卡顿就调小（如 2）；ASR 太慢可调大，但勿超过 (物理核 - 1)
    local_whisper_cpu_threads:

smtp:
  enabled: false
  host: ""
  port: 587
  username: ""
  password: ""
  from_email: ""
  use_tls: true

skill_marketplace:
  llm_review_enabled: false
  llm_review_model: null
