# ============================================================
# NovaMind 唯一后端配置文件（两层配置模型：本 yaml + 根目录 .env）
#
# - 分工：.env 只存账户密码/凭据（无默认值，缺失解析为 None 显性报错）；
#   连接参数（host/端点/桶名）在占位符内带本地基线默认值，本地开发零配置。
# - Docker 部署的连接值（容器名/生产桶名/ES 免认证）由 docker-compose.yml
#   的 app.environment 块显式注入（优先级高于 env_file 的 .env）。
# - 取值优先级：已 export 的进程环境变量 > .env 文件 > 占位符基线默认值。
# - 不要把真实密钥写进本文件（*.yaml 不进 git）。
# - 布尔值经环境变量表达时用字面量 true/false（整串占位符会归一为 bool）。
# ============================================================

project:
  name: novamind
  version: 0.1.0
  description: novamind backend

security:
  # 密钥统一走 ${VAR} 占位符：ConfigLoader 启动时自动加载仓库根 .env 取值，
  # 也可直接 export 环境变量覆盖。不要把真实密钥写进本文件（*.yaml 不进 git）。
  secret_key: "${SECRET_KEY}"
  algorithm: HS256
  access_token_expire_minutes: 30
  encryption_key: "${ENCRYPTION_KEY}"

database:
  host: "${DB_HOST:127.0.0.1}"
  port: 3306
  user: root
  password: "${MYSQL_ROOT_PASSWORD}"
  database: "${MYSQL_DATABASE:novamind_db}"
  pool_size: 10
  max_overflow: 20
  pool_timeout: 30
  pool_recycle: 3600
  pool_pre_ping: true

redis:
  enabled: "${REDIS_ENABLED:true}"
  host: "${REDIS_HOST:127.0.0.1}"
  port: 6379
  db: 0
  password: ""

minio:
  endpoint: "${MINIO_ENDPOINT:127.0.0.1:9005}"
  access_key: "${MINIO_ROOT_USER}"
  secret_key: "${MINIO_ROOT_PASSWORD}"
  # app↔MinIO 是否走 https。本地直连与 compose 内网（bridge 容器互通）保持 false；
  # MinIO 经 TLS 反代或公网可达时设 MINIO_SECURE=true（整串占位符归一为 bool）。
  secure: "${MINIO_SECURE:false}"
  region: us-east-1
  bucket_name: "${MINIO_BUCKET:novamind-dev}"
  # 外部服务（DashScope 等）下载文件时的公网地址，如 https://minio.example.com
  # 本地开发留空即可，部署时必填
  public_endpoint:

elasticsearch:
  hosts:
    - "${ES_HOST:http://127.0.0.1:9200}"
  # 用户名/密码任一为空即无认证（客户端 falsy 短路）；Docker 由 compose 注入空串走免认证
  username: "${ES_USERNAME:elastic}"
  password: "${ES_PASSWORD:}"
  index_prefix: kb
  default_embedding_dim: 1024
  analyzer: standard

vector_db:
  type: elasticsearch

admin:
  username: "admin"
  email: "admin@example.com"
  password: "${ADMIN_PASSWORD}"
  create_on_startup: true
  reset_password_if_exists: true

# 跨源白名单，逗号分隔；同源部署（nginx 反代前后端）用默认 * 即可
# （通配时 credentials 自动禁用，仅当存在跨源 API 消费方时才需要收紧）
cors_origins: "${CORS_ORIGINS:*}"

external_search:
  tavily:
    api_key: ""
    max_results: 10
    search_depth: basic
    timeout: 30
  serpapi:
    api_key: ""
    max_results: 10
    timeout: 30
  duckduckgo:
    max_results: 10
    timeout: 15

task_queue:
  max_jobs: 3
  job_timeout: 7200
  max_tries: 3
  retry_base_delay: 60
  queue_name: "arq:queue"

knowledge_ops:
  # 归因流水线（A1）：低分阈值与知识缺口看板同口径；降级阈值用于区分
  # content_gap（降阈值仍零命中）与 retrieval_failure（降阈值能命中）；
  # 回溯窗/批上限控制归因追赶成本（cron 每 30 分钟扫一批）
  attribution_low_score_threshold: 0.35
  attribution_replay_low_threshold: 0.15
  attribution_lookback_days: 7
  attribution_batch_limit: 50
  # 复审提醒（B2）：到期前提前提醒天数；确认复审时无周期文档的顺延天数
  review_advance_days: 7
  review_fallback_cycle_days: 90
  # 质量基线（C）：合成测试集单 KB 配额（LLM 成本硬闸）；跑批默认关（需 LLM 配额，按需开）
  testset_max_cases: 20
  quality_baseline_enabled: false

knowledge_base:
  parsing:
    # 解析快照与断点续跑总开关：false 全局关闭快照读写，重试走全量重算
    # （排障时可临时关闭以隔离快照层；读取失败按开启兜底）
    snapshots_enabled: true
    # 图片 VLM 描述入库文本上限（字符，默认 4000）。结构化 caption 含图中文字
    # 逐字转录；超限时逐字段（图中文字/实体/图表数据）受保护、其余段整段丢弃。
    # 按 embedding 模型上下文调整（换长文本 embedding 可调大）。
    image_caption_max_chars: 4000
    # 视频 VLM 逐帧/逐组描述并发数（1=串行，默认 4，范围 1~20）。
    # 长视频 60 帧串行易逼近 arq job_timeout，有界并发降时延；
    # 过高可能触发 VLM 配额限流，配合 KB 级 vlm_fallback_model / vlm_skip_on_quota_error 降级。
    video_vlm_concurrency: 4
    # ===== 本地 faster-whisper ASR（音频解析）=====
    # 模型档位（tiny/base/small/medium/large-v2/large-v3）。
    # 默认空 = large-v3（生产推荐档，中文识别最准）。
    # 开发机（8GB 内存无 GPU）必须显式降档：tiny（~75MB）或 small（~460MB）。
    # 部署期由 deploy 脚本按此档位预装到 backend/.cache/faster-whisper/{档位}
    # （compose 挂载为 /app/.cache/faster-whisper，容器重建不丢）。
    local_whisper_model:
    # 显式模型目录（绝对路径）。存量部署兼容通道，最高优先——配置后 local_whisper_model
    # 与部署预装目录均被覆盖。Docker 部署一般无需配置。
    local_whisper_model_dir:
    # 本地 ASR 转写 CPU 线程数；空则按物理核自动取保守值（留至少 1 核给事件循环）。
    # 转写时其它请求卡顿就调小（如 2）；ASR 太慢可调大，但勿超过 (物理核 - 1)。
    # GPU（device=cuda）下无效。
    local_whisper_cpu_threads:
    # 推理设备：auto（探测到 CUDA 自动用 GPU，生产无需配置）/ cpu / cuda。
    local_whisper_device:
    # 量化类型：auto（CPU→int8 / GPU→float16）/ int8 / int8_float16 / float16 / float32。
    local_whisper_compute_type:
    # 束搜索宽度（默认 5）。加大精度略升、速度线性下降。
    local_whisper_beam_size:
    # silero VAD 前置过滤（切静音/噪声段，省算力 + 抑制静音段幻觉），默认开。
    local_whisper_vad_enabled: true
    # 段级声学能量下限（RMS dBFS）。低于该值且文本很短（≤15 字符）的段视为
    # 底噪/静音残留幻觉丢弃。量级依据：正常语音约 -30~-20 dBFS，底噪约
    # -45~-40，-40 取两者分界；置空禁用该校验。
    local_whisper_min_speech_dbfs: -40
    # 空结果重试语言：转写结果为空且首跑语言置信度 <0.5 时按此语言重试一次。
    # 空则不重试。tiny/small 档对短中文音频常误判语言导致空结果，可配 zh。
    local_whisper_empty_result_retry_language:
    # 上传流式读取的全局字节硬顶（MB）：流式 sha256+计数边读边检，超限即断流拒收。
    # 须 >= 各模态上限（video 默认 2000MB）；与 nginx NGINX_MAX_BODY_SIZE 联动
    # （nginx 值应为本值 + multipart 头部裕量）。
    max_upload_size_mb: 2048
    # worker 下载 MinIO 原件的落盘目录（绝对路径）；空则用系统默认临时目录。
    # 大视频（2GB 级）流式写盘需要时，把它指到独立分区/数据盘，避免打爆系统盘。
    download_tmp_dir:
    # 分片上传暂存目录（绝对路径）；空则用系统临时目录下 novamind_chunk_uploads/。
    # 大文件分片暂存需要独立数据盘时配置（与 download_tmp_dir 同理）。
    chunk_upload_dir:
    # 分片上传会话 TTL（秒）；每次分片写入续期，过期 Redis 自动清理，
    # 残留 .part 由每日 cron 兜底扫删（mtime 超本值 2 倍）。
    chunk_upload_session_ttl_sec: 86400
    # 单分片最大体积（MB）；防单请求巨片，与 nginx client_max_body_size 联动。
    chunk_upload_max_chunk_mb: 32
    # 单用户并发分片上传会话数上限；防会话堆积占暂存盘。
    chunk_upload_max_sessions_per_user: 5

smtp:
  enabled: false
  host: ""
  port: 587
  username: ""
  password: ""
  from_email: ""
  use_tls: true

skill_marketplace:
  llm_review_enabled: false
  llm_review_model: null

asr:
  # 云端 ASR 凭据；值可写 ${OPENAI_API_KEY} 等 .env 占位符
  openai_api_key: ""
  openai_base_url: "https://api.openai.com/v1"
  dashscope_api_key: ""
  # 本地 faster-whisper 模型目录（第二回退；优先级在
  # knowledge_base.parsing.local_whisper_model_dir / local_whisper_model 之后）
  local_whisper_model_dir:

ocr:
  # 外部 OCR（qwen3.5-ocr）凭据；值可写 ${QWEN_OCR_API_KEY} 等 .env 占位符。
  # 默认面向官方 DashScope；使用中转/私有端点时在本地 yaml 覆盖 base_url
  # （*.yaml 不进 git，勿提交真实密钥与私有地址）。
  api_key: ""
  # OpenAI 兼容端点（document_parsing，PDF 直传 responses API）
  openai_base_url: "https://dashscope.aliyuncs.com/compatible-mode/v1"
  # DashScope 原生端点（multi_lan，单图 MultiModalConversation）
  dashscope_base_url: "https://dashscope.aliyuncs.com/api/v1"
  model: "qwen3.5-ocr"
  # PDF 渲页 DPI（multi_lan 路径逐页识别用）；300dpi 对公式识别显著优于 200dpi
  render_dpi: 300
  timeout: 120

agent:
  sandbox:
    # 代码执行沙箱（agent code_execution 工具）；enabled=false 时工具不注册
    enabled: false
    max_memory_mb: 256
    max_output_bytes: 65536
    default_timeout: 30
    max_timeout: 120
    network_disabled: true
    rebuild_interval: 50
    container_prefix: "agent_sandbox"
    images:
      python: "python:3.12-slim"
      javascript: "node:20-slim"
      shell: "bash:5"
  memory:
    # 长期记忆巩固后端：builtin（内置 LLM 提取，默认）| mem0（Mem0 语义调和，
    # 需 uv sync --extra mem0）。mem0 后端 LLM/embedding 走用户模型配置原始参数。
    backend: builtin
    # Mem0 工作存储的 ES collection 名（只服务调和比对，不对外检索）
    es_collection: "novamind_mem0"
    # 调和时参考的存量相似记忆条数
    history_size: 5
    # 压缩时记忆提取投递 arq 后台任务（true=异步，不入压缩关键路径，队列不可用自动退回同步；false=同步提取）
    on_turn_done: false
    # 压缩摘要生成投递 arq 后台任务（true=主循环不等 LLM 摘要走静态占位降级，任务落库后下轮请求生效；false=同步生成）
    compaction_async: false
    # AsyncMemory 实例 LRU 缓存数
    lru_size: 16
