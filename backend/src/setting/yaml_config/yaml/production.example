environment: production

# 生产必须收敛为前端实际域名列表（逗号分隔字符串或 YAML 数组），
# 继承 default.yaml 的 "*" 会禁用 credentials 且不满足生产安全要求
cors_origins: https://your-frontend-domain.com

minio:
  endpoint: your-minio-endpoint
  access_key: your-minio-access-key
  secret_key: your-minio-secret-key
  secure: true
  region: us-east-1
  bucket_name: knowledge-base
  # 生产环境必填：外部服务访问 MinIO 的公网地址
  public_endpoint: https://minio.your-domain.com

elasticsearch:
  hosts:
    - "http://your-es-host:9200"
  username: your-es-username
  password: your-es-password

database:
  host: your-db-host
  port: 3306
  user: your-db-user
  password: your-db-password
  database: your-db-name
  pool_size: 20
  max_overflow: 40

redis:
  enabled: true
  host: your-redis-host
  port: 6379
  password: your-redis-password

security:
  secret_key: your-secret-key
