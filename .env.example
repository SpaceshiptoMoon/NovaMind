# ---- NovaMind 环境配置 ----
# 复制此文件为 .env 并填入实际值:
#   cp .env.example .env
#
# .env 是唯一密钥源：
# - Docker Compose 用它插值容器环境变量并注入 app 容器
# - 本地开发时后端 ConfigLoader 启动时自动加载它，
#   解析 YAML 中的 ${VAR_NAME} 占位符（无需手动 export）

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=your-mysql-password
MYSQL_DATABASE=novamind_db

# ---- MinIO ----
MINIO_ROOT_USER=your-minio-access-key
MINIO_ROOT_PASSWORD=your-minio-secret-key

# ---- Elasticsearch ----
ES_JAVA_OPTS=-Xms512m -Xmx512m
# ES_PASSWORD 无需设置：Docker 部署的 ES 关闭了 security，compose 对 app 恒注入
# 空串走免认证。仅本地直连「开启认证」的 ES 时才在 .env 手动加
# ES_PASSWORD=实际密码（yaml 占位符 ${ES_PASSWORD:} 仍支持）

# ---- 后端安全 ----
# ⚠️ SECRET_KEY / ENCRYPTION_KEY 的占位值是公开仓库里的已知值，部署前必须替换，
# 否则 JWT 可被伪造、已加密存储的模型 API Key 可被解密
SECRET_KEY=your-jwt-secret-key
ENCRYPTION_KEY=your-aes256-encryption-key

# ---- 管理员账户 ----
# ⚠️ 管理员密码必须满足后端强度校验：8-30 位，且同时包含大写字母、小写字母、
# 数字、特殊字符。占位值不含大写/数字/特殊字符——直接用会在管理员已存在的
# 情况下（reset_password_if_exists=true 时）触发启动期校验失败、容器崩溃循环
ADMIN_PASSWORD=your-admin-password

# ---- 可选调优（非凭据，按需取消注释）----
# 跨源 API 消费方存在时收紧 CORS 白名单（默认 * 且 credentials 自动禁用；
# 同源部署——nginx 反代前后端——无需设置）
# CORS_ORIGINS=https://your-domain.example
# MinIO 经 TLS 反代/公网可达才需要 true；compose 内网容器互通保持默认 false 即可。
# MINIO_SECURE=false

# ---- DeepDoc 模型下载源 ----
# 模型下载主源（HuggingFace 端点）。部署期模型下载与容器内运行期兜底下载都
# 读这个变量。默认国内镜像 hf-mirror.com（国内网络直连 huggingface.co 不可达）；
# 海外部署请改为官方源：HF_ENDPOINT=https://huggingface.co 或直接删除此行
# （功能代码与 compose 的默认值均为官方源）。
HF_ENDPOINT=https://hf-mirror.com

# ---- DeepDoc 模型降级源（可选）----
# 主源 HF_ENDPOINT 全部失败后，按此清单顺序逐源补齐缺失的模型文件。
# 空值 = 不启用降级。配置是 JSON 数组，每项字段：
#   name     源标识（日志用）
#   url      地址模板，{repo} 替换为仓库名、{file} 替换为文件名
#   repo_map 可选，镜像站仓库名与 HF 不一致时映射（如 {"InfiniFlow/deepdoc": "AI-ModelScope/deepdoc"}）
# 示例（ModelScope 国内镜像，覆盖 deepdoc 与 text_concat 两个仓库；
# pix2text-mfr 在 ModelScope 无镜像，缺失文件会自动落到下一个源或报错）：
# DEEPDOC_MIRRORS=[{"name":"modelscope","url":"https://modelscope.cn/models/{repo}/resolve/master/{file}","repo_map":{"InfiniFlow/deepdoc":"AI-ModelScope/deepdoc","InfiniFlow/text_concat_xgb_v1.0":"AI-ModelScope/text_concat_xgb_v1.0"}}]
# 禁用降级（即使配置了也只用主源）：DEEPDOC_DISABLE_MIRRORS=1

# ---- DeepDoc 渲染与推理资源（可选，按机器内存调整）----
# PDF 分窗批处理的窗口页数：每 window_size 页渲染→OCR 融合→layout 推理→释放，
# 内存驻留上限 = 单窗（zoom=3 A4 约 13MB/页，默认 16 页 ≈220MB），与文档总页数无关。
# 默认 16（与 layout 推理 batch_size 对齐）；内存紧张可降到 8/4/1（1=逐页）。
# DEEPDOC_RENDER_WINDOW_SIZE=16
# 文字层渲染放大倍数（OCR/坐标精度 vs 内存）：默认 2；扫描件推荐 3。
# DEEPDOC_TEXT_PAGE_ZOOM=2
# 跳过模型文件 checksum 校验（默认校验，MODEL_CHECKSUMS 13 文件）：仅排查下载问题时临时使用。
# DEEPDOC_SKIP_MODEL_CHECKSUM=0

# ---- 本地 faster-whisper ASR 模型（音频解析）----
# 模型档位的权威配置在 backend/src/setting/yaml_config/yaml/default.yaml 的
# knowledge_base.parsing.local_whisper_model（tiny/base/small/medium/large-v2/large-v3）。
# 默认空 = 生产档 large-v3（部署脚本按此档位预装到 backend/.cache/faster-whisper/{档位}）。
# 开发机（8GB 内存无 GPU）在该 YAML 显式降档为 small 或 tiny——不要在此环境变量降档
# （档位影响部署预装与运行时解析，须两处同源）。
# NOVAMIND_LOCAL_WHISPER_MODEL_DIR=/abs/path/to/faster-whisper-model

# ---- nginx 上传体积与 TLS（可选）----
# 上传体积上限（nginx client_max_body_size）。须 >= 后端 video 模态上限
# （默认 2000MB）+ multipart 头部裕量，默认 2100m。调整后端 YAML 的
# knowledge_base.parsing.max_upload_size_mb 时同步调大这里。
# NGINX_MAX_BODY_SIZE=2100m
# TLS 证书（两者都非空才启用 HTTPS：443 server + 80 全局 301；留空=纯 HTTP）。
# 证书由运维提供（自签/机构签发均可），挂载进容器后填容器内路径：
#   volumes 追加: - ./deploy/tls:/etc/nginx/tls:ro
#   NGINX_TLS_CERT=/etc/nginx/tls/fullchain.pem
#   NGINX_TLS_KEY=/etc/nginx/tls/privkey.pem
# NGINX_TLS_CERT=
# NGINX_TLS_KEY=
