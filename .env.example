# ---- NovaMind 环境配置 ----
# 复制此文件为 .env 并填入实际值:
#   cp .env.example .env
#
# .env 是唯一密钥源：
# - Docker Compose 用它插值容器环境变量并注入 app 容器
# - 本地开发时后端 ConfigLoader 启动时自动加载它，
#   解析 YAML 中的 ${VAR_NAME} 占位符（无需手动 export）

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=your-mysql-password
MYSQL_DATABASE=novamind_db

# ---- MinIO ----
MINIO_ROOT_USER=your-minio-access-key
MINIO_ROOT_PASSWORD=your-minio-secret-key

# ---- Elasticsearch ----
ES_JAVA_OPTS=-Xms512m -Xmx512m
# 本地 compose 的 ES 关闭了 security，后端 yaml 仍引用此占位符，占位即可
ES_PASSWORD=your-es-password

# ---- 后端安全 ----
SECRET_KEY=your-jwt-secret-key
ENCRYPTION_KEY=your-aes256-encryption-key

# ---- 管理员账户 ----
ADMIN_PASSWORD=your-admin-password

# ---- DeepDoc 模型降级源（可选）----
# 主源 HF_ENDPOINT 全部失败后，按此清单顺序逐源补齐缺失的模型文件。
# 空值 = 不启用降级。配置是 JSON 数组，每项字段：
#   name     源标识（日志用）
#   url      地址模板，{repo} 替换为仓库名、{file} 替换为文件名
#   repo_map 可选，镜像站仓库名与 HF 不一致时映射（如 {"InfiniFlow/deepdoc": "AI-ModelScope/deepdoc"}）
# 示例（ModelScope 国内镜像，覆盖 deepdoc 与 text_concat 两个仓库；
# pix2text-mfr 在 ModelScope 无镜像，缺失文件会自动落到下一个源或报错）：
# DEEPDOC_MIRRORS=[{"name":"modelscope","url":"https://modelscope.cn/models/{repo}/resolve/master/{file}","repo_map":{"InfiniFlow/deepdoc":"AI-ModelScope/deepdoc","InfiniFlow/text_concat_xgb_v1.0":"AI-ModelScope/text_concat_xgb_v1.0"}}]
# 禁用降级（即使配置了也只用主源）：DEEPDOC_DISABLE_MIRRORS=1
