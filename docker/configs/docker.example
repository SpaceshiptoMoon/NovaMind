# ========================================
# Docker Compose runtime config example
# ========================================
# 1. Copy this file to docker.yaml
# 2. Keep the variable names aligned with root .env
# 3. The YAML loader resolves ${VAR_NAME} from container env vars

environment: docker

# 生产/公网部署时改为前端实际域名列表（逗号分隔字符串或 YAML 数组）；
# 留空继承 default.yaml 的 "*"（此时后端自动禁用 credentials 并告警）。
cors_origins: "*"

redis:
  enabled: true
  host: redis
  port: 6379
  db: 0
  password: null

minio:
  endpoint: minio:9005
  access_key: "${MINIO_ROOT_USER}"
  secret_key: "${MINIO_ROOT_PASSWORD}"
  secure: false

elasticsearch:
  hosts:
    - "http://elasticsearch:9200"
  username: null
  password: null

database:
  host: mysql
  port: 3306
  user: root
  password: "${MYSQL_ROOT_PASSWORD}"
  database: "${MYSQL_DATABASE}"

security:
  secret_key: "${SECRET_KEY}"
  encryption_key: "${ENCRYPTION_KEY}"

admin:
  username: "admin"
  email: "admin@example.com"
  password: "${ADMIN_PASSWORD}"
  create_on_startup: true
  reset_password_if_exists: true
